# ============================================================
#  Reminder + Quest-announcer BOT  (bot.py)  -- ToS-safe
# ============================================================
# Copy this file to ".env" and fill in the values you need.

DISCORD_TOKEN=your-bot-token-here

# Optional: where to store the SQLite database (default: reminders.db)
# DB_PATH=reminders.db

# Optional: how long before a quest ends to ping the channel (seconds)
# QUEST_DAY_LEAD_SECONDS=86400
# QUEST_HOUR_LEAD_SECONDS=3600

# Optional pluggable JSON feed for auto-adding quests to the BOT (advanced).
# QUEST_FEED_URL=https://example.com/quests.json
# QUEST_FEED_CHANNEL_ID=123456789012345678


# ============================================================
#  Quest NOTIFIER  (quest_notifier.py)  -- self-bot, ToS risk
# ============================================================
# ⚠️  This uses a USER account token (self-botting) which VIOLATES Discord's
#     Terms of Service. Use a THROWAWAY / ALT account, NEVER your main.
#     The account can be banned. Keep this token secret.

# DISCORD_USER_TOKEN=alt-account-user-token-here

# A Discord webhook URL to post quest notifications to
# (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
# QUEST_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional: seconds between checks (default 600 = 10 min). Keep it gentle.
# QUEST_POLL_SECONDS=600

# Optional: notify about already-active quests on the very first run (default true)
# QUEST_NOTIFY_EXISTING=true
